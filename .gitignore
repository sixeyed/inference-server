.DS_Store
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# Your config: machine addresses, paths to your disks, maybe a real api_key.
# config.example.json is the committed template.
config.json
docker/config.json
docker/known_hosts

# Live engine state, written by the dashboard.
settings.json

# Captured agent traces contain whatever source code was in the session.
traces/

# Model server logs. llama-server logs prompt content at higher verbosities.
logs/

# Usage database (the * catches the WAL and shm files)
usage.db*
